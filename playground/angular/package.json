{
	"name": "playground-angular",
	"version": "0.0.0",
	"scripts": {
		"dev": "ng serve --port 3004",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test"
	},
	"prettier": {
		"printWidth": 100,
