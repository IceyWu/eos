				}
			}
		]
	},
	"private": true,
	"dependencies": {
		"@angular/animations": "^22.2.3",
		"@angular/cdk": "^22.2.5",
		"@angular/common": "^22.2.3",
		"@angular/compiler": "^22.2.3",
		"@angular/core": "^22.2.3",
		"@angular/forms": "^22.2.3",
		"@angular/material": "^22.2.5",
		"@angular/platform-browser": "^22.2.3",
		"@angular/router": "^22.2.3",
		"@eosjs/ui": "workspace:*",
		"rxjs": "~7.8.2",
		"tslib": "^2.8.1",
		"zone.js": "~0.16.3"
	},
	"devDependencies": {
		"@angular/build": "^22.2.5",
		"@angular/cli": "^22.2.5",
		"@angular/compiler-cli": "^22.2.3",
		"@types/jasmine": "~5.1.15",
		"jasmine-core": "~5.13.0",
		"karma": "~6.4.4",
		"karma-chrome-launcher": "~3.2.0",
		"karma-coverage": "~2.2.1",
		"karma-jasmine": "~5.1.0",
