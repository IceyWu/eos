{
	"name": "eos",
	"version": "0.1.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @eosjs/components dev",
		"dev:utils": "pnpm --filter @eos/utils dev",
		"dev:all": "pnpm -r --parallel --filter \"@eosjs/components\" --filter \"@eos/utils\" --filter \"playground-*\" dev",
		"dev:docs": "pnpm --filter @eosjs/components-docs dev",
		"dev:html": "pnpm --filter playground-html dev",
		"dev:vue": "pnpm --filter playground-vue dev",
		"dev:react": "pnpm --filter playground-react dev",
		"dev:angular": "pnpm --filter playground-angular dev",
		"build": "pnpm build:utils && pnpm --filter @eosjs/components build",
		"build:utils": "pnpm --filter @eos/utils build",
		"build:components": "pnpm --filter @eosjs/components build",
		"build:docs": "pnpm build && pnpm --filter @eosjs/components-docs build",
		"build:all": "pnpm build:utils && pnpm build:components && pnpm build:docs",
		"format": "ultracite fix",
		"format:check": "ultracite check",
		"format:fix": "ultracite fix",
		"changelog": "changelogen --output CHANGELOG.md",
		"version:sync": "pnpm version:update-all && pnpm changelog",
		"version:update-all": "node scripts/sync-versions.js",
		"release": "pnpm version:sync && pnpm build:all && pnpm publish -r --no-git-checks",
		"release:dry": "pnpm version:sync && pnpm build:all && pnpm publish -r --dry-run",
		"version": "changelogen --bump",
		"version:patch": "changelogen --bump --patch && pnpm version:update-all",
		"version:minor": "changelogen --bump --minor && pnpm version:update-all",
		"version:major": "changelogen --bump --major && pnpm version:update-all"
	},
	"devDependencies": {
		"changelogen": "^0.6.2",
		"typescript": "^5.3.3",
		"ultracite": "^6.2.1"
	},
	"pnpm": {
		"overrides": {
			"vite": "npm:rolldown-vite@7.1.14"
		}
	}
}
