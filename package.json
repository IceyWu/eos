{
  "name": "eos",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @eosjs/components dev",
    "dev:utils": "pnpm --filter @eosjs/utils dev",
    "dev:all": "pnpm -r --parallel --filter \"@eosjs/components\" --filter \"@eosjs/utils\" --filter \"playground-*\" dev",
    "dev:docs": "lobedocs dev",
    "dev:html": "pnpm --filter playground-html dev",
    "dev:vue": "pnpm --filter playground-vue dev",
    "dev:react": "pnpm --filter playground-react dev",
    "dev:angular": "pnpm --filter playground-angular dev",
    "build": "pnpm build:utils && pnpm --filter @eosjs/components build",
    "build:utils": "pnpm --filter @eosjs/utils build",
    "build:components": "pnpm --filter @eosjs/components build",
    "build:docs": "pnpm build && lobedocs build",
    "build:all": "pnpm build:docs",
    "format": "ultracite fix",
    "format:check": "ultracite check",
    "changelog": "changelogen --output CHANGELOG.md",
    "changelog:release": "changelogen --release --output CHANGELOG.md",
    "version:update-all": "node scripts/sync-versions.js",
    "version:sync": "pnpm version:update-all && pnpm changelog:release",
    "release": "pnpm version:sync && pnpm build:all && pnpm publish -r --no-git-checks --registry https://registry.npmjs.org --access public",
    "release:dry": "pnpm version:sync && pnpm build:all && pnpm publish -r --dry-run --registry https://registry.npmjs.org --access public",
    "version:patch": "changelogen --bump --patch && pnpm version:update-all && pnpm changelog:release",
    "version:minor": "changelogen --bump --minor && pnpm version:update-all && pnpm changelog:release",
    "version:major": "changelogen --bump --major && pnpm version:update-all && pnpm changelog:release"
  },
  "devDependencies": {
    "@eosjs/components": "workspace:*",
    "@biomejs/biome": "^2.5.13",
    "@lobehub/docs-kit": "^5.27.3",
    "@mdx-js/react": "^3.1.1",
    "@react-router/dev": "8.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "changelogen": "^0.6.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.3.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "ultracite": "^7.12.0",
    "vite": "8.3.0"
  }
}
