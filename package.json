{
	"name": "eos",
	"version": "0.1.5",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"dev": "pnpm --filter @eosjs/ui dev",
		"dev:utils": "pnpm --filter @eosjs/utils dev",
		"dev:all": "pnpm -r --parallel --filter \"@eosjs/ui\" --filter \"@eosjs/utils\" --filter \"playground-*\" dev",
		"dev:docs": "pnpm --filter @eosjs/docs dev",
		"dev:html": "pnpm --filter playground-html dev",
		"dev:vue": "pnpm --filter playground-vue dev",
		"dev:react": "pnpm --filter playground-react dev",
		"dev:angular": "pnpm --filter playground-angular dev",
		"build": "pnpm build:utils && pnpm --filter @eosjs/ui build",
		"build:utils": "pnpm --filter @eosjs/utils build",
		"build:components": "pnpm --filter @eosjs/ui build",
		"build:docs": "pnpm build && pnpm --filter @eosjs/docs build",
		"format": "ultracite fix",
		"format:check": "ultracite check",
		"changeset": "changeset",
		"version": "changeset version"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@changesets/cli": "^3.0.3",
		"@eosjs/ui": "workspace:*",
		"@mdx-js/react": "^3.1.1",
		"@react-router/dev": "8.4.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "8.4.0",
		"tsx": "^4.23.13",
		"typescript": "^6.0.2",
		"ultracite": "^7.12.0",
		"vite": "8.3.0"
	}
}
