{
	"name": "@eosjs/ui",
	"version": "0.3.1",
	"description": "轻量级、框架无关的 Web Components 组件库",
	"keywords": [
		"web-components",
		"custom-elements",
		"typescript",
		"react",
		"vue",
		"angular",
		"solid",
		"preact"
	],
	"homepage": "https://eosjs.netlify.app/",
	"bugs": {
		"url": "https://github.com/IceyWu/eos/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IceyWu/eos.git",
		"directory": "packages/ui"
	},
	"license": "MIT",
	"type": "module",
	"main": "./dist/bundle.js",
	"module": "./dist/bundle.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/bundle.js",
			"default": "./dist/bundle.js"
		},
		"./jsx-types": {
			"types": "./jsx-types.d.ts"
		},
		"./progress-bar": {
			"types": "./dist/entries/progress-bar.d.ts",
			"import": "./dist/progress-bar.js",
			"default": "./dist/progress-bar.js"
		},
		"./image": {
			"types": "./dist/entries/image.d.ts",
			"import": "./dist/image.js",
			"default": "./dist/image.js"
		},
		"./button": {
			"types": "./dist/entries/button.d.ts",
			"import": "./dist/button.js",
			"default": "./dist/button.js"
		},
		"./card-stack": {
			"types": "./dist/entries/card-stack.d.ts",
			"import": "./dist/card-stack.js",
			"default": "./dist/card-stack.js"
		},
		"./carousel": {
			"types": "./dist/entries/carousel.d.ts",
			"import": "./dist/carousel.js",
			"default": "./dist/carousel.js"
		},
		"./image-group": {
			"types": "./dist/entries/image-group.d.ts",
			"import": "./dist/image-group.js",
			"default": "./dist/image-group.js"
		},
		"./scrollbar": {
			"types": "./dist/entries/scrollbar.d.ts",
			"import": "./dist/scrollbar.js",
			"default": "./dist/scrollbar.js"
		},
		"./select": {
			"types": "./dist/entries/select.d.ts",
			"import": "./dist/select.js",
			"default": "./dist/select.js"
		},
		"./scene": {
			"types": "./dist/entries/scene.d.ts",
			"import": "./dist/scene.js",
			"default": "./dist/scene.js"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js",
			"default": "./dist/config.js"
		}
	},
	"files": [
		"dist",
		"custom-elements.json",
		"jsx-types.d.ts"
	],
	"customElements": "custom-elements.json",
	"scripts": {
		"dev": "tsc --watch --preserveWatchOutput",
		"analyze": "cem analyze && node ./scripts/patch-jsx-types.mjs",
		"build": "pnpm run build:tsc && pnpm run build:bundle && pnpm run analyze",
		"build:tsc": "tsc",
		"build:bundle": "rollup -c",
		"test:exports": "node --test tests/exports.test.mjs"
	},
	"dependencies": {
		"@eosjs/utils": "workspace:*",
		"blurhash": "^2.0.5"
	},
	"devDependencies": {
		"@custom-elements-manifest/analyzer": "^0.11.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@wc-toolkit/jsx-types": "^1.8.2",
		"rollup": "^4.63.3",
		"typescript": "^6.0.2"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"sideEffects": [
		"./src/index.ts",
		"./dist/bundle.js",
		"./dist/bundle.min.js",
		"./dist/button.js",
		"./dist/card-stack.js",
		"./dist/carousel.js",
		"./dist/image.js",
		"./dist/image-group.js",
		"./dist/progress-bar.js",
		"./dist/scrollbar.js",
		"./dist/select.js",
		"./dist/scene.js"
	]
}
