{
	"name": "@eosjs/ui",
	"version": "0.2.1",
	"description": "轻量级、框架无关的 Web Components 组件库",
	"keywords": [
		"web-components",
		"custom-elements",
		"typescript",
		"react",
		"vue",
		"angular",
		"solid",
		"preact"
	],
	"homepage": "https://eosjs.netlify.app/",
	"bugs": {
		"url": "https://github.com/IceyWu/eos/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IceyWu/eos.git",
		"directory": "packages/ui"
	},
	"license": "MIT",
	"type": "module",
	"main": "./dist/bundle.js",
	"module": "./dist/bundle.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/bundle.js",
			"default": "./dist/bundle.js"
		},
		"./jsx-types": {
			"types": "./jsx-types.d.ts"
		}
	},
	"files": [
		"dist",
		"custom-elements.json",
		"jsx-types.d.ts"
	],
	"customElements": "custom-elements.json",
	"scripts": {
		"dev": "tsc --watch --preserveWatchOutput",
		"analyze": "cem analyze && node ./scripts/patch-jsx-types.mjs",
		"build": "pnpm run build:tsc && pnpm run build:bundle && pnpm run analyze",
		"build:tsc": "tsc",
		"build:bundle": "rollup -c"
	},
	"dependencies": {
		"@eosjs/utils": "workspace:*",
		"blurhash": "^2.0.5"
	},
	"devDependencies": {
		"@custom-elements-manifest/analyzer": "^0.11.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@wc-toolkit/jsx-types": "^1.8.2",
		"rollup": "^4.63.3",
		"typescript": "^6.0.2"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
