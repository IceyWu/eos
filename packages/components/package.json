{
  "name": "@eosjs/components",
  "version": "0.1.5",
  "type": "module",
  "main": "./dist/bundle.js",
  "module": "./dist/bundle.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bundle.js",
      "default": "./dist/bundle.js"
    },
    "./jsx-types": {
      "types": "./jsx-types.d.ts"
    }
  },
  "files": [
    "dist",
    "custom-elements.json",
    "jsx-types.d.ts"
  ],
  "customElements": "custom-elements.json",
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "analyze": "cem analyze && node ./scripts/patch-jsx-types.mjs",
    "build": "pnpm run build:tsc && pnpm run build:bundle && pnpm run analyze",
    "build:tsc": "tsc",
    "build:bundle": "rollup -c"
  },
  "dependencies": {
    "@eosjs/utils": "workspace:*",
    "blurhash": "^2.0.5"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@wc-toolkit/jsx-types": "^1.5.2",
    "rollup": "^4.60.1",
    "typescript": "^6.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
