{
	"name": "@eosjs/utils",
	"version": "0.1.5",
	"description": "Utility functions for Eos Web Components",
	"keywords": [
		"web-components",
		"custom-elements",
		"typescript",
		"eosjs",
		"utilities"
	],
	"homepage": "https://eosjs.netlify.app/",
	"bugs": {
		"url": "https://github.com/IceyWu/eos/issues"
	},
	"repository": {
